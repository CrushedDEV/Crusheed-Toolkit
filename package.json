{
  "name": "crushed-toolkit",
  "version": "0.1.6",
  "description": "Crushed Toolkit - Electron desktop app with modular tools (YouTube downloader module included)",
  "main": "backend/main.js",
  "type": "module",
  "author": "CrushedDEV",
  "repository": {
    "type": "git",
    "url": "https://github.com/CrushedDEV/crusheed-toolkit.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "publish": "electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "node-cron": "^4.6.0",
    "node-id3": "^0.2.9"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.crushed.toolkit",
    "productName": "Crushed Toolkit",
    "files": [
      "backend/**",
      "renderer/**",
      "modules/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    },
    "publish": [
      {
        "provider": "github"
      }
    ]
  }
}
